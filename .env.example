# ============================================================
# CCTV Public Server — contoh konfigurasi
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#     cp .env.example .env
# ============================================================

# Alamat host server (0.0.0.0 = bisa diakses dari luar mesin)
HOST=0.0.0.0

# Port server
PORT=8000

# Lokasi file katalog kamera (JSON)
DATA_FILE=data/cameras.json

# API key Windy Webcams — daftar gratis di https://www.windy.com/api
# (pilih "Webcams API", lalu minta access key). Kosongkan bila hanya
# memakai kamera manual/HLS milik sendiri.
WINDY_API_KEY=

# Bahasa metadata hasil Windy: "en" (pasti ada), coba "id" untuk Indonesia
WINDY_LANG=en

# Token admin opsional untuk endpoint /api/admin (header X-Admin-Token).
# Bila kosong, endpoint admin terbuka — hanya untuk penggunaan lokal!
ADMIN_TOKEN=

# CORS: daftar origin dipisah koma, "*" untuk mengizinkan semua
CORS_ORIGINS=*
